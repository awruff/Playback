{
	"schemaVersion": 1,
	"id": "${id}",
	"version": "${version}",
	"name": "${name}",
	"description": "Makes first-person replays look like what the player saw. Works as a Flashback add-on, or records and exports video by itself when Flashback isn't installed.",
	"license": "GPL-3.0-only",
	"icon": "assets/keyframe/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"org.polyfrost.keyframe.boot.KeyframeEntrypoint"
		],
		"keyframe-addon": [
			"org.polyfrost.keyframe.Keyframe"
		],
		"mixinsquared": [
			"org.polyfrost.keyframe.compat.LatticeCanceller"
		],
		"keyframe-standalone": [
			{
				"value": "org.polyfrost.keyframe.standalone.Standalone",
				"adapter": "kotlin"
			}
		]
	},
	"accessWidener": "keyframe.accesswidener",
	"mixins": [
		"keyframe.mixins.json",
		"keyframe.standalone.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader}",
		"minecraft": "${minecraft}",
		"java": ">=${java_version}",
		"fabric-api": "*",
		"fabric-language-kotlin": "*",
		"oneconfigv1": ">=${oneconfig}"
	},
	"suggests": {
		"flashback": ">=${flashback}"
	},
	"breaks": {
		"flashback": "<${flashback}"
	}
}
